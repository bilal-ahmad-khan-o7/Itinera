# Copy this file to server/.env for local development.
# On Railway, set these under Service -> Variables instead.

PORT=8080
NODE_ENV=development

# LLM provider (any OpenAI-compatible Chat Completions API). Defaults target Groq.
# Leave LLM_API_KEY empty to run in demo mode with realistic mock responses.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Only sent to reasoning models (e.g. gpt-oss): low | medium | high
LLM_REASONING_EFFORT=low

# Comma-separated list of origins allowed to call the API when the frontend
# is hosted separately (e.g. on Vercel). Not needed when Express serves the client build.
CORS_ORIGINS=http://localhost:5173

# Requests per minute per IP for /api/ai/* routes
AI_RATE_LIMIT_PER_MIN=20

# Sent to Wikipedia and OpenStreetMap as required by their usage policies
CONTACT_EMAIL=
